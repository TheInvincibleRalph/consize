# Local development defaults.
#
# Copy this file to deploy/dev/.env and change values there. The .env file is
# intentionally ignored by git.

CONSIZE_ENV=dev
DATABASE_URL=postgres://app:consize@127.0.0.1:15432/app?sslmode=disable
CONSIZE_LISTEN_PORT=8080
CONSIZE_AUTH_REQUIRED=false

# Dev keeps the verifier fast so the safety loop is visible while building.
# Production should use the deployment default unless explicitly overridden.
CONSIZE_VERIFY_WINDOW=1h
CONSIZE_SUSTAINED_MINUTES=3

# Local collection knobs. Use fixture sources unless you deliberately point dev
# at a local/throwaway cluster and Prometheus.
PROMETHEUS_URL=http://127.0.0.1:9090
CONSIZE_KUBECONFIG=
CONSIZE_NAMESPACES=
CONSIZE_DBMETRICS=fixture
# Cloud-waste scanning is disabled by default in dev. Set to "gcp" when you
# deliberately want to scan a live project, or "fixture" only for demo tests.
CONSIZE_COSTSCAN=none
CONSIZE_PRICING=static
CONSIZE_MIN_DATA_DAYS=0.1

# Optional: enables "Open PR" for IaC-backed recommendations.
# Keep the actual token only in deploy/dev/.env or your shell, never in git.
# The token needs repository contents write + pull request write access.
CONSIZE_GITHUB_TOKEN=
