# Production GKE defaults for the current live Consize installation.
#
# Copy this file to deploy/prod/env.sh and change only when the live topology
# changes. The env.sh file is intentionally ignored by git.

CONSIZE_ENV=prod
CONSIZE_GCP_PROJECT=devops-portfolio-prod
CONSIZE_GKE_REGION=us-central1
CONSIZE_GKE_CLUSTER=devops-portfolio
CONSIZE_KUBE_CONTEXT=gke_devops-portfolio-prod_us-central1_devops-portfolio
CONSIZE_NAMESPACE=consize-system
CONSIZE_API_SERVICE=consize-api
CONSIZE_API_LOCAL_PORT=18099
CONSIZE_IMAGE_REGISTRY=us-docker.pkg.dev/devops-portfolio-prod/consize
